<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema gelap konsol; AppCompat tidak dipakai (build tanpa Gradle/AndroidX). -->
    <style name="Theme.PocDialer" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="KeypadBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/key_text</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ActionBtn" parent="KeypadBtn">
        <item name="android:textSize">@dimen/action_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
