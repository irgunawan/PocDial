<?xml version="1.0" encoding="utf-8"?>
<!--
  Tata letak dialer: 6 baris berbobot (weightSum=6) memenuhi tinggi layar,
  jadi tidak pernah terpotong di radio 128x160 (Hytera PNC360S) maupun di HP.
  Ukuran teks dari @dimen + values-small; tanpa AndroidX (build aapt2+javac+d8).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="1dp"
    android:weightSum="6">

    <!-- baris 0: kolom nomor + hapus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_display"
            android:gravity="center_vertical|end"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:textColor="@color/text"
            android:textColorHint="#FF616161"
            android:textSize="@dimen/display_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:inputType="phone"
            android:hint="00"
            android:nextFocusDown="@id/key1"
            android:nextFocusRight="@id/btnDel" />

        <Button
            android:id="@+id/btnDel"
            style="@style/KeypadBtn"
            android:text="@string/del_label"
            android:contentDescription="Hapus"
            android:nextFocusDown="@id/key3"
            android:nextFocusLeft="@id/digits" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key1"
            style="@style/KeypadBtn"
            android:text="1"
            android:nextFocusRight="@id/key2"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key4" />

        <Button
            android:id="@+id/key2"
            style="@style/KeypadBtn"
            android:text="2"
            android:nextFocusLeft="@id/key1"
            android:nextFocusRight="@id/key3"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key4" />

        <Button
            android:id="@+id/key3"
            style="@style/KeypadBtn"
            android:text="3"
            android:nextFocusLeft="@id/key2"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key4" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key4"
            style="@style/KeypadBtn"
            android:text="4"
            android:nextFocusRight="@id/key5"
            android:nextFocusUp="@id/key1"
            android:nextFocusDown="@id/key7" />

        <Button
            android:id="@+id/key5"
            style="@style/KeypadBtn"
            android:text="5"
            android:nextFocusLeft="@id/key4"
            android:nextFocusRight="@id/key6"
            android:nextFocusUp="@id/key1"
            android:nextFocusDown="@id/key7" />

        <Button
            android:id="@+id/key6"
            style="@style/KeypadBtn"
            android:text="6"
            android:nextFocusLeft="@id/key5"
            android:nextFocusUp="@id/key1"
            android:nextFocusDown="@id/key7" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key7"
            style="@style/KeypadBtn"
            android:text="7"
            android:nextFocusRight="@id/key8"
            android:nextFocusUp="@id/key4"
            android:nextFocusDown="@id/keyStar" />

        <Button
            android:id="@+id/key8"
            style="@style/KeypadBtn"
            android:text="8"
            android:nextFocusLeft="@id/key7"
            android:nextFocusRight="@id/key9"
            android:nextFocusUp="@id/key4"
            android:nextFocusDown="@id/keyStar" />

        <Button
            android:id="@+id/key9"
            style="@style/KeypadBtn"
            android:text="9"
            android:nextFocusLeft="@id/key8"
            android:nextFocusUp="@id/key4"
            android:nextFocusDown="@id/keyStar" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyStar"
            style="@style/KeypadBtn"
            android:text="*"
            android:nextFocusRight="@id/key0"
            android:nextFocusUp="@id/key7"
            android:nextFocusDown="@id/aboutButton" />

        <Button
            android:id="@+id/key0"
            style="@style/KeypadBtn"
            android:text="0"
            android:nextFocusLeft="@id/keyStar"
            android:nextFocusRight="@id/keyPound"
            android:nextFocusUp="@id/key7"
            android:nextFocusDown="@id/aboutButton" />

        <Button
            android:id="@+id/keyPound"
            style="@style/KeypadBtn"
            android:text="#"
            android:nextFocusLeft="@id/key0"
            android:nextFocusUp="@id/key7"
            android:nextFocusDown="@id/aboutButton" />

    </LinearLayout>

    <!-- baris aksi: info / CALL / BATAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/aboutButton"
            style="@style/ActionBtn"
            android:layout_weight="1"
            android:background="@drawable/bg_info"
            android:text="@string/about_label"
            android:contentDescription="Tentang aplikasi"
            android:nextFocusRight="@id/callButton"
            android:nextFocusUp="@id/keyStar" />

        <Button
            android:id="@+id/callButton"
            style="@style/ActionBtn"
            android:layout_weight="2"
            android:background="@drawable/bg_call"
            android:text="@string/call_label"
            android:nextFocusLeft="@id/aboutButton"
            android:nextFocusRight="@id/cancelButton"
            android:nextFocusUp="@id/key0" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/ActionBtn"
            android:layout_weight="2"
            android:background="@drawable/bg_cancel"
            android:text="@string/cancel_label"
            android:nextFocusLeft="@id/callButton"
            android:nextFocusUp="@id/keyPound" />
    </LinearLayout>
</LinearLayout>
