<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dial_pad">

    <TextView
        android:id="@+id/dialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="@dimen/title_size"
        android:textStyle="bold"
        android:textColor="#111111"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingBottom="@dimen/gap_title" />

    <EditText
        android:id="@+id/digits"
        android:layout_width="match_parent"
        android:layout_height="@dimen/digits_height"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="phone"
        android:maxLines="1"
        android:nextFocusDown="@id/key1"
        android:textSize="@dimen/digits_text"
        android:gravity="center"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:hint="Nomor / USSD" />

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="@dimen/gap_keys">
        <Button
            android:id="@+id/key1"
            android:text="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key4"
            android:nextFocusLeft="@id/key3"
            android:nextFocusRight="@id/key2" />
        <Button
            android:id="@+id/key2"
            android:text="2"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key5"
            android:nextFocusLeft="@id/key1"
            android:nextFocusRight="@id/key3" />
        <Button
            android:id="@+id/key3"
            android:text="3"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/digits"
            android:nextFocusDown="@id/key6"
            android:nextFocusLeft="@id/key2"
            android:nextFocusRight="@id/key1" />
        <Button
            android:id="@+id/key4"
            android:text="4"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key1"
            android:nextFocusDown="@id/key7"
            android:nextFocusLeft="@id/key6"
            android:nextFocusRight="@id/key5" />
        <Button
            android:id="@+id/key5"
            android:text="5"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key2"
            android:nextFocusDown="@id/key8"
            android:nextFocusLeft="@id/key4"
            android:nextFocusRight="@id/key6" />
        <Button
            android:id="@+id/key6"
            android:text="6"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key3"
            android:nextFocusDown="@id/key9"
            android:nextFocusLeft="@id/key5"
            android:nextFocusRight="@id/key4" />
        <Button
            android:id="@+id/key7"
            android:text="7"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key4"
            android:nextFocusDown="@id/keyStar"
            android:nextFocusLeft="@id/key9"
            android:nextFocusRight="@id/key8" />
        <Button
            android:id="@+id/key8"
            android:text="8"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key5"
            android:nextFocusDown="@id/key0"
            android:nextFocusLeft="@id/key7"
            android:nextFocusRight="@id/key9" />
        <Button
            android:id="@+id/key9"
            android:text="9"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key6"
            android:nextFocusDown="@id/keyPound"
            android:nextFocusLeft="@id/key8"
            android:nextFocusRight="@id/key7" />
        <Button
            android:id="@+id/keyStar"
            android:text="*"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key7"
            android:nextFocusDown="@id/callButton"
            android:nextFocusLeft="@id/key0"
            android:nextFocusRight="@id/keyPound" />
        <Button
            android:id="@+id/key0"
            android:text="0"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key8"
            android:nextFocusDown="@id/callButton"
            android:nextFocusLeft="@id/keyStar"
            android:nextFocusRight="@id/keyPound" />
        <Button
            android:id="@+id/keyPound"
            android:text="#"
            android:layout_width="0dp"
            android:layout_height="@dimen/key_height"
            android:layout_columnWeight="1"
            android:focusable="true"
            android:clickable="true"
            android:textSize="@dimen/key_text"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusUp="@id/key9"
            android:nextFocusDown="@id/callButton"
            android:nextFocusLeft="@id/key0"
            android:nextFocusRight="@id/keyStar" />
    </GridLayout>

    <Button
        android:id="@+id/aboutButton"
        android:text="@string/about_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/about_height"
        android:layout_marginTop="@dimen/gap_keys"
        android:focusable="true"
        android:clickable="true"
        android:textSize="@dimen/about_text_size"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:nextFocusUp="@id/callButton" />

    <Button
        android:id="@+id/callButton"
        android:text="@string/call_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/call_height"
        android:layout_marginTop="@dimen/gap_keys"
        android:focusable="true"
        android:clickable="true"
        android:textSize="@dimen/call_text_size"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:nextFocusUp="@id/keyPound"
        android:nextFocusLeft="@id/keyPound"
        android:nextFocusRight="@id/keyPound" />
</LinearLayout>
</ScrollView>
