<?xml version="1.0" encoding="utf-8"?>
<!--
  Dialer 6 baris berbobot (weightSum=6): selalu muat, termasuk 128x160 px.
  Urutan fokus DPAD melingkar: 1 2 3 4 5 6 7 8 9 * 0 # CALL lalu kembali ke 1.
  Tanpa AndroidX (aapt2 + javac + d8).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="1dp"
    android:weightSum="6">

    <!-- baris 0: kolom nomor (tanpa tombol X) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/digits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_display"
            android:gravity="center_vertical|end"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="@color/text"
            android:textColorHint="#FF616161"
            android:textSize="@dimen/display_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:inputType="phone"
            android:hint="00"
            android:nextFocusDown="@+id/key1"
            android:nextFocusRight="@+id/key1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key1"
            style="@style/KeypadBtn"
            android:text="1"
            android:nextFocusRight="@+id/key2"
            android:nextFocusDown="@+id/key2"
            android:nextFocusLeft="@+id/callButton"
            android:nextFocusUp="@+id/callButton" />

        <Button
            android:id="@+id/key2"
            style="@style/KeypadBtn"
            android:text="2"
            android:nextFocusRight="@+id/key3"
            android:nextFocusDown="@+id/key3"
            android:nextFocusLeft="@+id/key1"
            android:nextFocusUp="@+id/key1" />

        <Button
            android:id="@+id/key3"
            style="@style/KeypadBtn"
            android:text="3"
            android:nextFocusRight="@+id/key4"
            android:nextFocusDown="@+id/key4"
            android:nextFocusLeft="@+id/key2"
            android:nextFocusUp="@+id/key2" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key4"
            style="@style/KeypadBtn"
            android:text="4"
            android:nextFocusRight="@+id/key5"
            android:nextFocusDown="@+id/key5"
            android:nextFocusLeft="@+id/key3"
            android:nextFocusUp="@+id/key3" />

        <Button
            android:id="@+id/key5"
            style="@style/KeypadBtn"
            android:text="5"
            android:nextFocusRight="@+id/key6"
            android:nextFocusDown="@+id/key6"
            android:nextFocusLeft="@+id/key4"
            android:nextFocusUp="@+id/key4" />

        <Button
            android:id="@+id/key6"
            style="@style/KeypadBtn"
            android:text="6"
            android:nextFocusRight="@+id/key7"
            android:nextFocusDown="@+id/key7"
            android:nextFocusLeft="@+id/key5"
            android:nextFocusUp="@+id/key5" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key7"
            style="@style/KeypadBtn"
            android:text="7"
            android:nextFocusRight="@+id/key8"
            android:nextFocusDown="@+id/key8"
            android:nextFocusLeft="@+id/key6"
            android:nextFocusUp="@+id/key6" />

        <Button
            android:id="@+id/key8"
            style="@style/KeypadBtn"
            android:text="8"
            android:nextFocusRight="@+id/key9"
            android:nextFocusDown="@+id/key9"
            android:nextFocusLeft="@+id/key7"
            android:nextFocusUp="@+id/key7" />

        <Button
            android:id="@+id/key9"
            style="@style/KeypadBtn"
            android:text="9"
            android:nextFocusRight="@+id/keyStar"
            android:nextFocusDown="@+id/keyStar"
            android:nextFocusLeft="@+id/key8"
            android:nextFocusUp="@+id/key8" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyStar"
            style="@style/KeypadBtn"
            android:text="*"
            android:nextFocusRight="@+id/key0"
            android:nextFocusDown="@+id/key0"
            android:nextFocusLeft="@+id/key9"
            android:nextFocusUp="@+id/key9" />

        <Button
            android:id="@+id/key0"
            style="@style/KeypadBtn"
            android:text="0"
            android:nextFocusRight="@+id/keyPound"
            android:nextFocusDown="@+id/keyPound"
            android:nextFocusLeft="@+id/keyStar"
            android:nextFocusUp="@+id/keyStar" />

        <Button
            android:id="@+id/keyPound"
            style="@style/KeypadBtn"
            android:text="#"
            android:nextFocusRight="@+id/callButton"
            android:nextFocusDown="@+id/callButton"
            android:nextFocusLeft="@+id/key0"
            android:nextFocusUp="@+id/key0" />

    </LinearLayout>

    <!-- baris aksi: tombol telepon bulat (gaya dialer Android) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/callButton"
            android:layout_width="@dimen/call_size"
            android:layout_height="@dimen/call_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_call"
            android:padding="@dimen/call_icon_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call"
            android:contentDescription="Panggil"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:nextFocusRight="@+id/key1"
            android:nextFocusDown="@+id/key1"
            android:nextFocusLeft="@+id/keyPound"
            android:nextFocusUp="@+id/keyPound" />
    </FrameLayout>
</LinearLayout>
